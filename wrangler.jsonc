{
  "name": "mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "services": [
    {
      "binding": "RADAR_API",
      "service": "radar-live-api"
    }
  ]
}
